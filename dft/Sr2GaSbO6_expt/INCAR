SYSTEM = HSE06 Sr2GaSbO6 static on experimental I4/m structure (P3.3 reconciliation)

# Electronic
ENCUT      = 520
PREC       = Accurate
EDIFF      = 1E-5
LREAL      = .FALSE.
ALGO       = Damped
TIME       = 0.4
NELM       = 200
NELMIN     = 6
ISMEAR     = 0
SIGMA      = 0.05

# Non-magnetic (Ga3+ d10 / Sb5+ d10)
ISPIN      = 1

# HSE06 hybrid functional settings (identical to lab exemplar Sr2InSbO6)
GGA        = PE
LHFCALC    = .TRUE.
HFSCREEN   = 0.2
AEXX       = 0.25
AGGAX      = 0.75
AGGAC      = 1.00
ALDAC      = 1.00
PRECFOCK   = Fast

# Static calculation — geometry is the neutron-refined experimental structure, NOT relaxed
NSW        = 0
IBRION     = -1
ICHARG     = 2

# Output
LWAVE      = .FALSE.
LCHARG     = .FALSE.
LORBIT     = 11

# Parallelization
KPAR       = 1
NCORE      = 4
